rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. PROPRIEDADES (Catálogo Imobiliário em Tempo Real)
    // Permite leitura pública e gravação/publicação imediata de imóveis.
    match /properties/{propertyId} {
      allow read, write: if true;
    }

    // 2. CATEGORIAS DE IMÓVEIS
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // 3. CONFIGURAÇÕES DO SITE & CONTACTOS OFICIAIS
    match /site_settings/{settingId} {
      allow read, write: if true;
    }

    // 4. SLIDES DO BANNER HERO
    match /hero_slides/{slideId} {
      allow read, write: if true;
    }

    // 5. MENSAGENS DO MARQUEE (BARRA SUPERIOR)
    match /marquee_items/{itemId} {
      allow read, write: if true;
    }

    // 6. CHAT DE ATENDIMENTO ONLINE & CONVERSAS
    match /conversations/{conversationId} {
      allow read, write: if true;
    }

    // 7. ALERTAS DE IMÓVEIS (Área do Cliente)
    match /alerts/{alertId} {
      allow read, write: if true;
    }

    // 8. NOTIFICAÇÕES DO SISTEMA
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // 9. TESTE DE CONEXÃO
    match /test/{docId} {
      allow read, write: if true;
    }

    // Regra padrão de fallback
    match /{document=**} {
      allow read, write: if true;
    }

  }
}
